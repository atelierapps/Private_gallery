<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude everything: no ADB/cloud backup of the vault (spec §10). -->
<full-backup-content>
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
    <exclude domain="root" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!-- The share sheet's window carries its own scrim, so it fades rather than
     moving — sliding the window would slide the dimming with it. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="180" />

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      No INTERNET permission, by design (spec §10). Exfiltration is made
      structurally impossible. If a dependency ever merges one in, the
      tools:node="remove" below strips it back out — audit the merged
      manifest after every dependency bump.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- Gallery import (spec §4). API 33+ split media permissions; legacy on <=32. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!--
      Held only while an export or restore is running. A backup of a few hundred
      files takes long enough that the screen will go off partway through, and
      without this the work stops there and the whole run is wasted.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- In-app camera: capture straight into the vault (never touches the gallery). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".VaultApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Vault"
        android:allowBackup="false"
        android:fullBackupContent="@xml/empty_backup_rules"
        android:dataExtractionRules="@xml/empty_extraction_rules"
        android:hardwareAccelerated="true"
        tools:targetApi="34">

        <!--
          MainActivity carries no launcher filter of its own. Every launcher
          entry is an activity-alias below, so the app's name and icon can be
          swapped at runtime by enabling one alias and disabling the rest
          (AppDisguise). An alias changes only the launcher entry — the package
          id stays com.atelierapps.vault, so the Keystore wrap key and every
          encrypted file survive a switch untouched.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Vault" />

        <activity-alias
            android:name=".Launcher.Link"
            android:targetActivity=".ui.MainActivity"
            android:label="@string/disguise_link"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.Notes"
            android:targetActivity=".ui.MainActivity"
            android:label="@string/disguise_notes"
            android:icon="@mipmap/ic_alias_notes"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.Calculator"
            android:targetActivity=".ui.MainActivity"
            android:label="@string/disguise_calculator"
            android:icon="@mipmap/ic_alias_calculator"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.Weather"
            android:targetActivity=".ui.MainActivity"
            android:label="@string/disguise_weather"
            android:icon="@mipmap/ic_alias_weather"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.Files"
            android:targetActivity=".ui.MainActivity"
            android:label="@string/disguise_files"
            android:icon="@mipmap/ic_alias_files"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".Launcher.Clock"
            android:targetActivity=".ui.MainActivity"
            android:label="@string/disguise_clock"
            android:icon="@mipmap/ic_alias_clock"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Export / backup + restore (spec §11). -->
        <activity
            android:name=".ui.export.ExportActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />
        <activity
            android:name=".ui.restore.RestoreActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Full-screen viewer (spec §8). configChanges keeps the activity alive
             across rotation so video playback position, loop, and play state are
             preserved instead of restarting from the beginning. -->
        <activity
            android:name=".ui.viewer.ViewerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Vault" />

        <!-- Recycle bin (spec §8). -->
        <activity
            android:name=".ui.trash.TrashActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Auto-tag rules manager (spec §7). -->
        <activity
            android:name=".ui.rules.RulesActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Tag manager (spec §7). -->
        <activity
            android:name=".ui.tags.TagsActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Storage + library stats. -->
        <activity
            android:name=".ui.storage.StorageActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Settings (spec §7, §9). -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Albums (spec §7). -->
        <activity
            android:name=".ui.albums.AlbumsActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />
        <activity
            android:name=".ui.albums.AlbumActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- In-app camera: capture straight into the vault. -->
        <activity
            android:name=".ui.camera.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Vault" />

        <!-- Byte-identical copies, grouped for review. -->
        <activity
            android:name=".ui.duplicates.DuplicatesActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Rotate / crop one item, saving through the normal encrypt pipeline. -->
        <activity
            android:name=".ui.edit.ImageEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Importer: MediaStore picker + folder import (spec §4, §4.1). -->
        <activity
            android:name=".imports.ImportActivity"
            android:exported="false"
            android:theme="@style/Theme.Vault" />

        <!-- Save-from-anywhere share target (spec §5). Transparent, no auth to save. -->
        <activity
            android:name=".share.ShareReceiverActivity"
            android:label="@string/share_target_label"
            android:theme="@style/Theme.Vault.Transparent"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <meta-data
                android:name="android.service.chooser.chooser_target_service"
                android:value="" />
        </activity>

        <!-- Direct Share / sharing shortcuts (spec §5). -->
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />

        <!--
          Share-out: hands a single decrypted item to another app the user picks,
          via a temporary content URI over the cacheDir/share spool only. Not
          exported; grants are per-share and read-only.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
